[Unit]
Description=WRO Robot - Sistema de Navegación Autónoma
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/WRO2026-neutrinos-electronicos/code/raspberry_pi
ExecStart=/home/pi/WRO2026-neutrinos-electronicos/code/raspberry_pi/start_robot.sh
Restart=always
RestartSec=10

# Variables de entorno para cámara
Environment="LD_LIBRARY_PATH=/opt/vc/lib"

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wro-robot

# Seguridad
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
